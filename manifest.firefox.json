{
    "manifest_version": 3,
    "name": "DloadLIB",
    "version": "1.0.0",
    "description": "Неофициальный форк DownloadLib (ivanvit100). Скачивает мангу и ранобэ с MangaLib, HentaiLib, RanobeLib и com-x.",
    "background": {
        "page": "background/background.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@dloadlib",
            "strict_min_version": "109.0"
        }
    },
    "action": {
        "default_title": "DloadLIB — скачать тайтл",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "activeTab",
        "tabs",
        "downloads",
        "storage",
        "webRequest",
        "webRequestBlocking",
        "scripting",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "https://mangalib.me/*",
        "https://mangalib.org/*",
        "https://ranobelib.me/*",
        "https://api.cdnlibs.org/*",
        "https://cover.cdnlibs.org/*",
        "https://img1.cdnlibs.org/*",
        "https://img2.cdnlibs.org/*",
        "https://img3.cdnlibs.org/*",
        "https://img3.mixlib.me/*",
        "https://img2.imgslib.link/*",
        "https://cover.imglib.info/*",
        "https://com-x.life/*",
        "https://*.com-x.life/*",
        "https://hentailib.me/*",
        "https://*.hentaicdn.org/*",
        "https://*/*"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "manga_headers",
                "enabled": true,
                "path": "rules.firefox.json"
            }
        ]
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval' blob:; object-src 'self'"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mangalib.me/*",
                "https://mangalib.org/*",
                "https://ranobelib.me/*"
            ],
            "js": [
                "content/AdCleaner.js",
                "content/DownloadButton.js",
                "content/ImageFetcher.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://com-x.life/*"
            ],
            "js": [
                "content/DownloadButton.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://hentailib.me/*"
            ],
            "js": [
                "content/DownloadButton.js",
                "content/ImageFetcher.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
